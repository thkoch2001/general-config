# 0.2 style config
keyboard {
  layout de, ro, ru
  options grp:shifts_toggle

  repeat {
    rate 25
    delay 400
  }
}

touchpad {
  #natural_scroll true # hardcoded to true in v 0.2
  # this could be two_finger, edge, no_scroll or on_button_down
  scroll_method two_finger
  tap_to_click true
  disable_while_typing true
}

# 0.4 style config
input {
  profiles {
    default {
      keyboard {
        layout de, ro, ru
#        options grp:win_space_toggle, compose:ralt, caps:super
        options grp:shifts_toggle
      }

      touchpad {
        tap_to_click true
        disable_while_typing true
      }
    }
  }

  rules [
    any, default
  ]
}
